# Copy to .env and fill in. The pipeline reads these at runtime.

# --- LLM provider (swappable) ---
# FREE option (recommended): Google Gemini free tier. Key: aistudio.google.com -> "Get API key".
LLM_PROVIDER=google            # google | gemini | openai
# LLM_MODEL accepts a comma-separated FALLBACK CHAIN. Pin more than one: a single free slug
# being withdrawn by the provider is how nine consecutive weekly runs died with no fallback.
# Later entries are tried only when the earlier one is gone or quota-exhausted.
#   LLM_MODEL=primary-model:free,backup-model:free
LLM_MODEL=gemini-2.0-flash     # free-tier model; also: gemini-2.5-flash, gemini-1.5-flash
GOOGLE_API_KEY=AIza...         # <-- your Gemini key goes here
#
# PAID option: OpenAI (no free tier, but gpt-4o-mini costs pennies per scan).
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Web search (the "eyes" — LLMs can't browse on their own) ---
# Tavily free tier: ~1,000 searches/mo, no card. Key: app.tavily.com
SEARCH_BACKEND=tavily          # tavily | none
TAVILY_API_KEY=tvly-...        # <-- your Tavily key goes here
SEARCH_DEPTH=advanced          # basic (1 credit/query) | advanced (2 credits, fuller results)
SEARCH_MAX_RESULTS=12          # articles pulled per query (Tavily default is 8)

# --- Pipeline tunables (see config.py) ---
T_SETTLE_DAYS=7                # events newer than this are held as provisional
N_MIN_SOURCES=2               # independent sources required to corroborate
AUTO_APPROVE_CONFIDENCE=0.8   # >= this + all-pass -> auto-approve queue (less human review)

# --- Paths ---
SEED_JSON=../src/data/seed.json   # the app dataset we resolve against / propose into
OUTPUT_DIR=./out                  # proposals + review queue land here

# Cache LLM responses by prompt hash. Off for weekly runs (every week is new content, so it
# would only ever miss); on for `eval`, where the same prompts are replayed while tuning and
# re-paying for them makes measurement too expensive to repeat.
LLM_CACHE=off

# ---- daily cursor ----
# The unit of work is one DAY. Each run asks: what is the oldest day we have not checked yet?
# Days already in the coverage ledger are skipped; failed or blind days are retried.
# One slot per run is reserved for the NEWEST settled day, so the map is current from the first
# run however far back this reaches; the remaining slots drain the backlog oldest-first. The
# backlog therefore closes at (PIPELINE_MAX_DAYS_PER_RUN - 1) days per run. Centuries are still
# a range scan, not a cursor job: `python -m conflict_updater scan "1974..1975"`.
PIPELINE_START_DATE=2026-06-01
# How many unchecked days to process per run: 1 for the newest day plus (N-1) backlog days.
# MUST be > 1, or there is no backlog slot at all and an old start date never closes.
# Each day costs roughly 2 + 3 x --limit LLM calls, so raise it with the quota in mind.
PIPELINE_MAX_DAYS_PER_RUN=3
# After this many inconclusive attempts a day is left behind, so one permanently un-searchable
# date cannot stall every day queued behind it.
COVERAGE_MAX_ATTEMPTS=3

# ---- duplicate / continuation guard ----
# An event within this many days of an existing one, with a near-identical title AND the same
# kind, is the same continuing operation rather than a new event. A change of kind (attack ->
# ceasefire) is always treated as a real development.
CONTINUATION_DAYS=3
DUPLICATE_TITLE_FLOOR=0.85

# Minimum historical CONSEQUENCE for an event to publish without review. This is `significance`,
# NOT `severity`: a ceasefire is severity 1 and significance 5. Anything below the bar is held
# for review rather than dropped.
MIN_SIGNIFICANCE_AUTO=3

# ---- typed decisions (TypeSafe / Jev) ----
# Which backend answers the CHOICE / SCORE / CONFIDENCE questions: the resolver's match, event
# kind, conflict type, severity, party roles, status, significance, and the verify verdict.
# The LLM keeps the prose — search queries, event titles, summaries.
#
# Why it matters most for the verdict: an LLM's "confidence: 0.85" is a token it generated, and
# AUTO_APPROVE_CONFIDENCE gates everything this pipeline publishes on exactly that number. A
# System One model derives confidence from the probability distribution over the options.
#
# "none" leaves every judgement with the LLM, exactly as before.
# Hard cap on searches per scan. The Scoper prompt asks for "at most 6", but a prompt is not a
# budget — nothing enforced it, and every query is a billed Tavily search (2 credits at advanced
# depth). Capped in code instead.
MAX_QUERIES=6

# How likely an article must be to report a datable event before the Extractor sees it. The
# triage judge scores the whole fetched pool in one call; a typical day drops ~85% of it, which
# is what keeps the Extractor prompt small enough to actually succeed.
TRIAGE_THRESHOLD=0.6

JUDGE_BACKEND=jev            # none | jev
TYPESAFE_API_KEY=            # from https://console.typesafe.ai/
